{
  "name": "@fixturesmith/core",
  "version": "0.0.0",
  "description": "Schema-neutral deterministic fixture generation engine",
  "homepage": "https://github.com/sykes10/FixtureSmith#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sykes10/FixtureSmith.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sykes10/FixtureSmith/issues"
  },
  "keywords": [
    "fixtures",
    "testing",
    "test-data",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "package:check": "publint"
  },
  "publishConfig": {
    "access": "public"
  }
