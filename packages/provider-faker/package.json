{
  "name": "@fixturesmith/provider-faker",
  "version": "0.1.0",
  "description": "Faker primitive provider for FixtureSmith",
  "homepage": "https://github.com/sykes10/FixtureSmith#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sykes10/FixtureSmith.git",
    "directory": "packages/provider-faker"
  },
  "bugs": {
    "url": "https://github.com/sykes10/FixtureSmith/issues"
  },
  "keywords": [
    "faker",
    "fixtures",
    "testing",
    "test-data"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "package:check": "publint"
  },
  "dependencies": {
    "@faker-js/faker": "10.5.0",
    "@fixturesmith/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
