{
  "name": "@fixturesmith/zod",
  "version": "0.1.0",
  "description": "Generate typed deterministic fixtures from Zod schemas",
  "homepage": "https://github.com/sykes10/FixtureSmith#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sykes10/FixtureSmith.git",
    "directory": "packages/zod"
  },
  "bugs": {
    "url": "https://github.com/sykes10/FixtureSmith/issues"
  },
  "keywords": [
    "zod",
    "fixtures",
    "testing",
    "test-data",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "package:check": "publint"
  },
  "dependencies": {
    "@fixturesmith/core": "workspace:*",
    "@fixturesmith/provider-faker": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
