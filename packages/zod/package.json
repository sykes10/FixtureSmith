{
  "name": "@fixturesmith/zod",
  "version": "0.0.0",
  "description": "Generate typed deterministic fixtures from Zod schemas",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "package:check": "publint"
  },
  "dependencies": {
    "@fixturesmith/core": "workspace:*",
    "@fixturesmith/provider-faker": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
